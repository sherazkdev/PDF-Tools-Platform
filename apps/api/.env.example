# Application
APP_ENV=development
APP_NAME=PDF Tools API
API_PREFIX=/api/v1

# Server
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Storage (local path for development)
STORAGE_ROOT=./var/storage
JOB_TTL_SECONDS=3600

# Limits (bytes)
MAX_UPLOAD_BYTES=52428800
MAX_FILES_PER_JOB=20
MAX_STORAGE_BYTES=5368709120
UPLOAD_CHUNK_BYTES=262144
WORKER_TIMEOUT_SECONDS=300
MAX_CONCURRENT_JOBS=4
RATE_LIMIT_JOBS_PER_MINUTE=30

# Test-only converter (off in production)
ENABLE_TEST_CONVERTER=false

# Job download authorization header name
JOB_ACCESS_HEADER=X-Job-Access-Token
